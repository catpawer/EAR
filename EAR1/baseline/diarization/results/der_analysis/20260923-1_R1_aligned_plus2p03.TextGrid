            text = ""
        intervals [28]:
            xmin = 221.800000
            xmax = 223.610000
            text = "嗯，都是刺激的项目。"
        intervals [29]:
            xmin = 223.610000
            xmax = 223.660000
            text = ""
        intervals [30]:
            xmin = 223.660000
            xmax = 225.450000
            text = "劝你别去，哈哈哈。"
        intervals [31]:
            xmin = 225.450000
            xmax = 272.100000
            text = ""
        intervals [32]:
            xmin = 272.100000
            xmax = 273.480000
