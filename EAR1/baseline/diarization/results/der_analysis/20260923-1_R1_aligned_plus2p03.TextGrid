            text = "呃。"
        intervals [397]:
            xmin = 922.210000
            xmax = 922.610000
            text = ""
        intervals [398]:
            xmin = 922.610000
            xmax = 925.600000
            text = "你到了济南去吃把子肉的时候，你会感觉到那个。"
        intervals [399]:
            xmin = 925.600000
            xmax = 925.810000
            text = ""
        intervals [400]:
            xmin = 925.810000
            xmax = 929.200000
            text = "把子肉你就是吃到嘴里边儿它就化开了。"
        intervals [401]:
            xmin = 929.200000
            xmax = 929.860000
            text = ""
        intervals [402]:
            xmin = 929.860000
            xmax = 932.170000
            text = "它有肉香，它就化开了它不是那种。"
        intervals [403]:
            xmin = 932.170000
            xmax = 932.310000
            text = ""
        intervals [404]:
            xmin = 932.310000
