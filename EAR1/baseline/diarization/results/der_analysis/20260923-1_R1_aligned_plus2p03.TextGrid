            text = "呃，整体逛下来的话。"
        intervals [377]:
            xmin = 890.540000
            xmax = 891.220000
            text = ""
        intervals [378]:
            xmin = 891.220000
            xmax = 892.460000
            text = "最让我。"
        intervals [379]:
            xmin = 892.460000
            xmax = 892.640000
            text = ""
        intervals [380]:
            xmin = 892.640000
            xmax = 896.360000
            text = "流连忘返的，我前段时间还一直跟我朋友说，我说我一定要再去一次济南。"
        intervals [381]:
            xmin = 896.360000
            xmax = 896.570000
            text = ""
        intervals [382]:
            xmin = 896.570000
            xmax = 898.200000
            text = "我那个民我那个。"
        intervals [383]:
            xmin = 898.200000
            xmax = 898.870000
            text = ""
        intervals [384]:
            xmin = 898.870000
            xmax = 903.950000
            text = "住的酒店楼下有一家把子肉，太香了我靠，真的太香了。"
        intervals [385]:
            xmin = 903.950000
            xmax = 904.330000
            text = ""
        intervals [386]:
            xmin = 904.330000
            xmax = 905.120000
            text = "就是。"
        intervals [387]:
            xmin = 905.120000
            xmax = 905.800000
            text = ""
        intervals [388]:
            xmin = 905.800000
            xmax = 907.220000
            text = "吃了一次还想吃。"
        intervals [389]:
            xmin = 907.220000
            xmax = 909.340000
            text = ""
        intervals [390]:
            xmin = 909.340000
            xmax = 912.490000
            text = "我推荐你们也去尝尝那个把子肉。"
        intervals [391]:
            xmin = 912.490000
            xmax = 913.190000
            text = ""
        intervals [392]:
            xmin = 913.190000
            xmax = 914.740000
            text = "加青椒特别香。"
        intervals [393]:
            xmin = 914.740000
            xmax = 919.000000
            text = ""
        intervals [394]:
            xmin = 919.000000
            xmax = 921.220000
            text = "有，区别很大就是。"
