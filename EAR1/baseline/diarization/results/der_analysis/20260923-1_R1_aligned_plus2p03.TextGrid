            text = ""
        intervals [66]:
            xmin = 550.540000
            xmax = 555.940000
            text = "然后一打听一百块钱，我说拉倒吧，我说还是用自个儿命爬吧。"
        intervals [67]:
            xmin = 555.940000
            xmax = 556.960000
            text = ""
        intervals [68]:
            xmin = 556.960000
            xmax = 560.210000
            text = "对，走下来之后坐的大巴，然后下山。"
