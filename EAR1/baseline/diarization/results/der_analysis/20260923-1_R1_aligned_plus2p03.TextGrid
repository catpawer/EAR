            text = "行。"
        intervals [3]:
            xmin = 11.400000
            xmax = 128.930000
            text = ""
        intervals [4]:
            xmin = 128.930000
            xmax = 132.100000
            text = "你为啥吃不惯那个，嘎巴菜。"
        intervals [5]:
            xmin = 132.100000
            xmax = 136.280000
            text = ""
        intervals [6]:
            xmin = 136.280000
            xmax = 139.410000
            text = "是因为有那个麻酱吗？阿哈。"
        intervals [7]:
            xmin = 139.410000
            xmax = 144.580000
            text = ""
        intervals [8]:
            xmin = 144.580000
            xmax = 146.510000
            text = "有点顶饱了是吗？"
        intervals [9]:
            xmin = 146.510000
            xmax = 151.160000
            text = ""
        intervals [10]:
            xmin = 151.160000
            xmax = 155.060000
            text = "我觉得你没有尝过那个豆腐脑那个豆腐脑更一般。哈哈。"
        intervals [11]:
            xmin = 155.060000
            xmax = 163.940000
            text = ""
        intervals [12]:
            xmin = 163.940000
            xmax = 165.960000
            text = "外地人就是吃不惯.。"
        intervals [13]:
            xmin = 165.960000
            xmax = 172.140000
            text = ""
        intervals [14]:
            xmin = 172.140000
            xmax = 178.210000
            text = "里边儿就是那个绿豆，绿豆做的那个面皮儿，对，然后放点儿卤子。"
        intervals [15]:
            xmin = 178.210000
            xmax = 178.350000
            text = ""
        intervals [16]:
            xmin = 178.350000
            xmax = 183.610000
            text = "嗯，对对对，就跟咱们，吃的那个豆腐脑儿那个卤差不多，但是它是放麻酱的。"
        intervals [17]:
            xmin = 183.610000
            xmax = 186.940000
            text = ""
        intervals [18]:
            xmin = 186.940000
            xmax = 188.650000
            text = "*不是。"
        intervals [19]:
            xmin = 188.650000
            xmax = 189.500000
            text = ""
        intervals [20]:
            xmin = 189.500000
            xmax = 192.900000
            text = "只有它里面儿那个主食，只有那个面皮儿。"
        intervals [21]:
            xmin = 192.900000
            xmax = 196.750000
            text = ""
        intervals [22]:
            xmin = 196.750000
            xmax = 198.280000
            text = "对对对对对。"
        intervals [23]:
            xmin = 198.280000
