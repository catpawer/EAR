            xmin = 1011.150000
            xmax = 1011.810000
            text = ""
        intervals [426]:
            xmin = 1011.810000
            xmax = 1018.540000
            text = "嗯，东北那边儿的话，他们的其实，他们的冬冬天的氛围，就是尤其尤其临近年关，他们的氛围更浓郁。"
