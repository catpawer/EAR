            text = ""
        intervals [410]:
            xmin = 941.450000
            xmax = 948.330000
            text = "那块儿肉你放到米饭上面儿，然后你把米饭搅匀，就是它就基本上跟米饭融到一块 儿 了，不会有肉，甚至连肉丝儿都。"
        intervals [411]:
            xmin = 948.330000
