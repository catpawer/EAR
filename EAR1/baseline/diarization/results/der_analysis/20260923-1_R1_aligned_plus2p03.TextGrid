            xmin = 273.480000
            xmax = 276.150000
            text = ""
        intervals [34]:
            xmin = 276.150000
            xmax = 278.800000
            text = "为什么我去的时候没看到日出。"
        intervals [35]:
            xmin = 278.800000
            xmax = 279.860000
            text = ""
        intervals [36]:
            xmin = 279.860000
            xmax = 283.140000
            text = "我呃自己的原因吧，起晚了，哈哈。"
        intervals [37]:
            xmin = 283.140000
            xmax = 283.660000
            text = ""
        intervals [38]:
            xmin = 283.660000
            xmax = 285.330000
            text = "对，起晚了。"
        intervals [39]:
            xmin = 285.330000
            xmax = 475.730000
            text = ""
        intervals [40]:
            xmin = 475.730000
            xmax = 477.340000
            text = "山西那边儿吗？"
        intervals [41]:
            xmin = 477.340000
            xmax = 480.400000
            text = ""
        intervals [42]:
            xmin = 480.400000
            xmax = 483.330000
            text = "吃完中午饭不会晕炭吗？啊哈哈哈。"
        intervals [43]:
            xmin = 483.330000
            xmax = 495.320000
            text = ""
        intervals [44]:
            xmin = 495.320000
            xmax = 501.240000
            text = "对，我有一个山西的大学同学，他就是自己带醋，因为吃不惯咱们这边的醋。"
        intervals [45]:
            xmin = 501.240000
            xmax = 501.370000
            text = ""
        intervals [46]:
            xmin = 501.370000
            xmax = 502.900000
            text = "咱这边醋他嫌没味。"
        intervals [47]:
            xmin = 502.900000
            xmax = 508.210000
            text = ""
        intervals [48]:
            xmin = 508.210000
            xmax = 511.720000
            text = "嗯，我爬过，夜爬过泰山。"
        intervals [49]:
            xmin = 511.720000
            xmax = 512.060000
            text = ""
        intervals [50]:
            xmin = 512.060000
            xmax = 516.180000
            text = "然后就是大二的时候我们几个同学一起。"
        intervals [51]:
            xmin = 516.180000
            xmax = 516.380000
            text = ""
        intervals [52]:
            xmin = 516.380000
            xmax = 518.830000
            text = "铁腚坐六个小时火车。"
        intervals [53]:
            xmin = 518.830000
            xmax = 519.810000
            text = ""
        intervals [54]:
            xmin = 519.810000
            xmax = 520.490000
            text = "然后。"
        intervals [55]:
            xmin = 520.490000
            xmax = 520.660000
            text = ""
        intervals [56]:
            xmin = 520.660000
            xmax = 527.210000
            text = "对然后晚上十点多开始爬，然后爬到了第二天早上五点多，看的日出。"
        intervals [57]:
            xmin = 527.210000
            xmax = 528.090000
            text = ""
        intervals [58]:
            xmin = 528.090000
            xmax = 534.080000
            text = "然后就是我到山顶儿其实特别害怕，但是我那个同学是个女生儿。"
        intervals [59]:
            xmin = 534.080000
            xmax = 534.430000
            text = ""
        intervals [60]:
            xmin = 534.430000
            xmax = 542.970000
            text = "然后她就要去爬到那个没有护栏的山边儿上，她要她要拍她要站到那儿拍照儿，我就一直拽着她，哈。"
        intervals [61]:
            xmin = 542.970000
            xmax = 544.460000
            text = ""
        intervals [62]:
            xmin = 544.460000
            xmax = 548.470000
            text = "然后我们下下山的时候儿，本来计划好的是坐。"
        intervals [63]:
            xmin = 548.470000
            xmax = 548.730000
            text = ""
        intervals [64]:
            xmin = 548.730000
            xmax = 550.200000
            text = "坐那个缆车下来。"
        intervals [65]:
