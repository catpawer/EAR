        intervals [418]:
            xmin = 999.750000
            xmax = 1003.920000
            text = "我记得我记得说的是其实真唐家。"
        intervals [419]:
            xmin = 1003.920000
            xmax = 1004.200000
            text = ""
        intervals [420]:
            xmin = 1004.200000
            xmax = 1008.090000
            text = "真正在意唐那个唐雪见的只有他爷爷。"
        intervals [421]:
            xmin = 1008.090000
            xmax = 1008.280000
            text = ""
        intervals [422]:
            xmin = 1008.280000
            xmax = 1012.320000
            text = "其他人都把唐雪见自始至终当成外人。"
