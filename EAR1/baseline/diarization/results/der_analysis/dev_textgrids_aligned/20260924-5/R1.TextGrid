            text = ""
        intervals [332]:
            xmin = 1372.440000
            xmax = 1374.800000
            text = "嗯，盐碎。"
        intervals [333]:
            xmin = 1374.800000
            xmax = 1385.510000
            text = ""
        intervals [334]:
            xmin = 1385.510000
            xmax = 1390.250000
            text = "嗯，是他也不不喜欢吃香菜的，感觉那个味道有点像臭大姐，那味道。"
        intervals [335]:
            xmin = 1390.250000
