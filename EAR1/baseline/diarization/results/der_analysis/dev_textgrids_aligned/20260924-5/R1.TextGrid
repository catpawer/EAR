            xmin = 363.430000
            xmax = 408.590000
            text = ""
        intervals [8]:
            xmin = 408.590000
            xmax = 410.720000
            text = "这怎么我一个都没吃过啊。"
        intervals [9]:
            xmin = 410.720000
            xmax = 496.530000
            text = ""
        intervals [10]:
            xmin = 496.530000
            xmax = 497.600000
            text = "马上开播。"
