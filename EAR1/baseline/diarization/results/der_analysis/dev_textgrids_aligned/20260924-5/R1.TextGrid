            text = ""
        intervals [348]:
            xmin = 1427.470000
            xmax = 1428.340000
            text = "是。"
        intervals [349]:
            xmin = 1428.340000
            xmax = 1429.180000
            text = ""
        intervals [350]:
            xmin = 1429.180000
            xmax = 1432.610000
            text = "榴莲可以，你是对榴莲过敏吗？"
