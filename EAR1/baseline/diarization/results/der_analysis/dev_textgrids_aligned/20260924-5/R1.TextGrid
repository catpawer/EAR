            text = ""
        intervals [2]:
            xmin = 72.760000
            xmax = 74.890000
            text = "在本地好像还有一家。"
        intervals [3]:
            xmin = 74.890000
            xmax = 74.930000
            text = ""
        intervals [4]:
            xmin = 74.930000
            xmax = 78.290000
            text = "比较火的火烧好像是什么铁炙火烧烧夹鱼那个。"
        intervals [5]:
            xmin = 78.290000
            xmax = 78.930000
            text = ""
        intervals [6]:
            xmin = 78.930000
            xmax = 80.850000
            text = "我觉得那个，对。"
        intervals [7]:
            xmin = 80.850000
            xmax = 81.740000
            text = ""
        intervals [8]:
            xmin = 81.740000
            xmax = 83.170000
            text = "那就是那一个店儿吗？"
        intervals [9]:
            xmin = 83.170000
            xmax = 83.340000
            text = ""
        intervals [10]:
            xmin = 83.340000
            xmax = 85.070000
            text = "那是个店儿，然后呢我觉得那个。"
        intervals [11]:
            xmin = 85.070000
            xmax = 85.240000
            text = ""
        intervals [12]:
            xmin = 85.240000
            xmax = 90.150000
            text = "火烧夹鱼也是热的比较好吃我因为我去他店里吃过也让别人帮我打包回来过。"
        intervals [13]:
            xmin = 90.150000
            xmax = 90.620000
            text = ""
        intervals [14]:
            xmin = 90.620000
            xmax = 94.840000
            text = "我觉得就是在店儿里吃比较好吃，拿回来的话它。"
        intervals [15]:
            xmin = 94.840000
            xmax = 95.030000
            text = ""
        intervals [16]:
            xmin = 95.030000
            xmax = 98.740000
            text = "它那皮儿也不是那么脆了，然后它那个肉也凉了，我就觉得比较。"
        intervals [17]:
            xmin = 98.740000
            xmax = 99.200000
            text = ""
        intervals [18]:
            xmin = 99.200000
            xmax = 100.300000
            text = "比较一般。"
        intervals [19]:
            xmin = 100.300000
            xmax = 102.320000
            text = ""
        intervals [20]:
            xmin = 102.320000
            xmax = 105.440000
            text = "那个店儿在一个村儿里。"
        intervals [21]:
            xmin = 105.440000
            xmax = 106.520000
            text = ""
        intervals [22]:
            xmin = 106.520000
            xmax = 108.280000
            text = "是咱们这儿好像在那个。"
        intervals [23]:
            xmin = 108.280000
            xmax = 108.400000
            text = ""
        intervals [24]:
            xmin = 108.400000
            xmax = 110.210000
            text = "对，荣成贾贾光。"
        intervals [25]:
            xmin = 110.210000
            xmax = 110.610000
            text = ""
        intervals [26]:
            xmin = 110.610000
            xmax = 112.960000
            text = "对王王家庄那边儿吧，好像是。"
        intervals [27]:
            xmin = 112.960000
            xmax = 114.260000
            text = ""
        intervals [28]:
            xmin = 114.260000
            xmax = 115.950000
            text = "对就是夹鱼，那个鱼。"
        intervals [29]:
            xmin = 115.950000
            xmax = 116.130000
            text = ""
        intervals [30]:
            xmin = 116.130000
            xmax = 118.180000
            text = "不是那个鱼，是炖的。"
        intervals [31]:
            xmin = 118.180000
            xmax = 118.610000
            text = ""
        intervals [32]:
            xmin = 118.610000
            xmax = 121.050000
            text = "炖的，那个刺是软的。"
