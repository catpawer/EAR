            xmin = 1391.670000
            xmax = 1397.350000
            text = ""
        intervals [338]:
            xmin = 1397.350000
            xmax = 1401.540000
            text = "你比如说那种孜然羊肉之类的，那不都是放那香菜吗？"
        intervals [339]:
            xmin = 1401.540000
            xmax = 1402.210000
            text = ""
        intervals [340]:
            xmin = 1402.210000
            xmax = 1402.860000
            text = "对吧。"
        intervals [341]:
            xmin = 1402.860000
            xmax = 1404.220000
            text = ""
        intervals [342]:
            xmin = 1404.220000
            xmax = 1406.710000
            text = "就缺少点感觉的是吧。"
        intervals [343]:
            xmin = 1406.710000
            xmax = 1410.630000
            text = ""
        intervals [344]:
            xmin = 1410.630000
            xmax = 1414.720000
            text = "茴香，茴香我不爱吃。"
        intervals [345]:
            xmin = 1414.720000
            xmax = 1418.280000
            text = ""
        intervals [346]:
            xmin = 1418.280000
            xmax = 1420.750000
            text = "对，我也觉得是茴香有股怪味。"
