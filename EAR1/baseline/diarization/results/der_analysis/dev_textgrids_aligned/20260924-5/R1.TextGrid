            xmin = 542.440000
            xmax = 543.840000
            text = ""
        intervals [18]:
            xmin = 543.840000
            xmax = 546.630000
            text = "因为这东西比较上瘾。"
        intervals [19]:
            xmin = 546.630000
            xmax = 547.130000
            text = ""
        intervals [20]:
            xmin = 547.130000
            xmax = 550.410000
            text = "一喝就感觉拉嗓子，一拉嗓子就感觉特别舒服。"
