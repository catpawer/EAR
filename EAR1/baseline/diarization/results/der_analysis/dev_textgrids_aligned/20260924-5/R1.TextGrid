            xmin = 497.600000
            xmax = 527.030000
            text = ""
        intervals [12]:
            xmin = 527.030000
            xmax = 528.880000
            text = "她说没有差异性是吧。"
        intervals [13]:
            xmin = 528.880000
            xmax = 534.280000
            text = ""
        intervals [14]:
            xmin = 534.280000
            xmax = 536.020000
            text = "喝，喝可乐。"
