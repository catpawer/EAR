            xmin = 138.160000
            xmax = 149.320000
            text = ""
        intervals [42]:
            xmin = 149.320000
            xmax = 151.520000
            text = "不是吧我觉得它怎么是分。"
        intervals [43]:
            xmin = 151.520000
            xmax = 151.930000
            text = ""
        intervals [44]:
            xmin = 151.930000
            xmax = 157.300000
            text = "分对它你那一个火，对，它只能给你加满，但是我觉得不是一条鱼，是一一点。"
        intervals [45]:
            xmin = 157.300000
            xmax = 157.820000
            text = ""
        intervals [46]:
            xmin = 157.820000
            xmax = 159.760000
            text = "对，反正就是一部分吧。"
