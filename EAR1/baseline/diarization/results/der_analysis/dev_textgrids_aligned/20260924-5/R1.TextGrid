            xmin = 159.760000
            xmax = 161.870000
            text = ""
        intervals [48]:
            xmin = 161.870000
            xmax = 167.680000
            text = "就是那比较火嘛，他凌晨三点就开始营业了。就是凌晨三点就去有人排队，然后一直到早上。"
        intervals [49]:
            xmin = 167.680000
            xmax = 170.240000
            text = ""
        intervals [50]:
            xmin = 170.240000
            xmax = 172.160000
            text = "哎呀我怎么说呀，我感觉就是。"
        intervals [51]:
            xmin = 172.160000
            xmax = 172.990000
            text = ""
        intervals [52]:
            xmin = 172.990000
            xmax = 175.220000
            text = "我感觉就是网上。"
        intervals [53]:
            xmin = 175.220000
            xmax = 175.260000
            text = ""
        intervals [54]:
            xmin = 175.260000
            xmax = 177.690000
            text = "我就觉得网上吹捧起来的吧，就是。"
