            text = "" 
        intervals [12]:
            xmin = 85.13 
            xmax = 90.04 
            text = "火烧夹鱼也是热的比较好吃我因为我去他店里吃过也让别人帮我打包回来过。" 
        intervals [13]:
            xmin = 90.04 
