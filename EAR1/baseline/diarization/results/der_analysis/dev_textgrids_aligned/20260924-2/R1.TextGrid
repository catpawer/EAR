            xmin = 1161.410000
            xmax = 1161.870000
            text = ""
        intervals [140]:
            xmin = 1161.870000
            xmax = 1170.720000
            text = "不只是K P L所有的游戏比赛，我觉得现在越去随着越来越大众越来越广泛，他就是会饭圈严重这个是无法避免的，不只是K P L 。"
        intervals [141]:
            xmin = 1170.720000
            xmax = 1170.980000
            text = ""
        intervals [142]:
            xmin = 1170.980000
            xmax = 1180.720000
            text = "所以说，只是我们可能很多人就是为什么讨厌的原因，就是有一个比如说有一个职业选手我我我其实不是讨厌他，但是。"
        intervals [143]:
            xmin = 1180.720000
            xmax = 1180.920000
            text = ""
        intervals [144]:
            xmin = 1180.920000
            xmax = 1188.650000
            text = "他不让我，不是让我很喜欢，因为不是因为他这个人而是因为他的粉丝群体让我很讨厌，我觉得，就这种粉丝。"
        intervals [145]:
            xmin = 1188.650000
            xmax = 1188.880000
            text = ""
        intervals [146]:
            xmin = 1188.880000
            xmax = 1200.610000
            text = "第一他们可能不玩游戏不看比赛他们只觉得这个人或者有谁跟风吹他嘛，他就觉得自己这个人啊应该挺厉害的，他就跟风吹他嘛，我觉得用这个来看粉丝体量的话是不切实际的。"
        intervals [147]:
            xmin = 1200.610000
            xmax = 1259.740000
            text = ""
        intervals [148]:
            xmin = 1259.740000
            xmax = 1265.330000
            text = "呃，现在我想问一下大家就是其他的喜欢的人就是为什么。"
        intervals [149]:
            xmin = 1265.330000
            xmax = 1265.660000
            text = ""
        intervals [150]:
            xmin = 1265.660000
            xmax = 1279.200000
            text = "说出来为什么喜欢他吧，或者说他的一些个性格呀个人的经历，我觉得大家有没有什么了解的，就是比如说我们现在很多明星单独去了解这个人了解他的经历他的性格为什么去了解他，我觉得大家有没有这种想法呢。"
        intervals [151]:
            xmin = 1279.200000
            xmax = 1322.020000
            text = ""
        intervals [152]:
            xmin = 1322.020000
            xmax = 1324.890000
            text = "好的，我想，我的意思是。"
        intervals [153]:
            xmin = 1324.890000
            xmax = 1325.420000
            text = ""
        intervals [154]:
            xmin = 1325.420000
            xmax = 1330.610000
            text = "当然你喜欢这个明星肯定是或者有学到一些什么东西，这个是一个好的方向吧。"
        intervals [155]:
            xmin = 1330.610000
            xmax = 1331.190000
            text = ""
        intervals [156]:
            xmin = 1331.190000
            xmax = 1339.830000
            text = "我要说的，就是其实这种明星他的什么代言品牌这种真正的比如说那些五年网暴什么黑子，其实对人家来说就不算，什么人家就是。"
        intervals [157]:
            xmin = 1339.830000
            xmax = 1340.180000
            text = ""
        intervals [158]:
            xmin = 1340.180000
            xmax = 1342.630000
            text = "真的就是不在乎。其次。"
        intervals [159]:
            xmin = 1342.630000
            xmax = 1360.880000
            text = ""
        intervals [160]:
            xmin = 1360.880000
            xmax = 1363.150000
            text = "我的意思是，当然这种。"
        intervals [161]:
            xmin = 1363.150000
            xmax = 1363.720000
            text = ""
        intervals [162]:
            xmin = 1363.720000
            xmax = 1370.560000
            text = "但是呃，首先这种出面的什么玩儿梗公开这种我觉得大多数。"
        intervals [163]:
            xmin = 1370.560000
            xmax = 1370.950000
            text = ""
        intervals [164]:
            xmin = 1370.950000
            xmax = 1374.010000
            text = "有，就算有本人的意愿吧但是我觉得大多数是不是的。"
        intervals [165]:
            xmin = 1374.010000
            xmax = 1374.350000
            text = ""
        intervals [166]:
            xmin = 1374.350000
            xmax = 1375.420000
            text = "然后其次。"
        intervals [167]:
            xmin = 1375.420000
            xmax = 1375.710000
            text = ""
        intervals [168]:
            xmin = 1375.710000
            xmax = 1377.810000
            text = "就是我的意思是有没有大家觉得这个。"
        intervals [169]:
            xmin = 1377.810000
            xmax = 1377.970000
            text = ""
        intervals [170]:
            xmin = 1377.970000
            xmax = 1382.490000
            text = "人真的发自内心的喜欢觉得他的性格和跟自己很合得来，或者说。"
        intervals [171]:
            xmin = 1382.490000
            xmax = 1382.760000
            text = ""
        intervals [172]:
            xmin = 1382.760000
            xmax = 1389.800000
            text = "他有自己值得学习的地方，我觉得这个就是我们现在追星我我也认识几个朋友，他们也喜欢一些个明星吧。"
        intervals [173]:
            xmin = 1389.800000
            xmax = 1390.070000
            text = ""
        intervals [174]:
            xmin = 1390.070000
            xmax = 1400.660000
            text = "他们就是觉得这个明星真的从小到大陪了我很长时间，或者说他的一些个性格，或者他做的一些事让我真的很喜欢，我觉得大大家有没有这种呢。"
        intervals [175]:
            xmin = 1400.660000
            xmax = 1412.070000
            text = ""
        intervals [176]:
            xmin = 1412.070000
            xmax = 1423.910000
            text = "嗯，就像我刚刚说的吧我就是那个职业选手嘛，其次就是他的性格，他的就是很简单就是一句话我幻想中的自己，我觉得这就是我为什么喜欢他。"
        intervals [177]:
            xmin = 1423.910000
            xmax = 1428.192667
            text = ""
    item [2]:
        class = "IntervalTier"
        name = "P030"
        xmin = 0
        xmax = 1428.192667
        intervals: size = 59
        intervals [1]:
            xmin = 0.000000
            xmax = 10.420000
            text = ""
        intervals [2]:
            xmin = 10.420000
            xmax = 14.410000
            text = "额，我来说一下我最喜欢的人物吧，哈。"
        intervals [3]:
            xmin = 14.410000
            xmax = 15.000000
            text = ""
        intervals [4]:
            xmin = 15.000000
            xmax = 25.430000
            text = "嗯，他是一个历史上的人物，是明朝正德年间的一个有名的圣人，叫王守仁，也就是大家常说的王阳明。"
        intervals [5]:
            xmin = 25.430000
            xmax = 25.720000
            text = ""
        intervals [6]:
            xmin = 25.720000
            xmax = 27.180000
            text = "啊我个人。"
        intervals [7]:
            xmin = 27.180000
            xmax = 27.340000
            text = ""
        intervals [8]:
            xmin = 27.340000
            xmax = 33.040000
            text = "主要是之前了解过历史然后还看过明朝那些事这本小说。"
        intervals [9]:
            xmin = 33.040000
            xmax = 33.320000
            text = ""
        intervals [10]:
            xmin = 33.320000
            xmax = 35.000000
            text = "所以对他比较了解。"
        intervals [11]:
            xmin = 35.000000
            xmax = 35.180000
            text = ""
        intervals [12]:
            xmin = 35.180000
            xmax = 37.500000
            text = "嗯，发现他是一个。"
        intervals [13]:
            xmin = 37.500000
            xmax = 38.480000
            text = ""
        intervals [14]:
            xmin = 38.480000
            xmax = 40.770000
            text = "品性坚韧。然后。"
        intervals [15]:
            xmin = 40.770000
            xmax = 41.240000
            text = ""
        intervals [16]:
            xmin = 41.240000
            xmax = 44.430000
            text = "额，又明白事理的一个。"
        intervals [17]:
            xmin = 44.430000
            xmax = 46.020000
            text = ""
        intervals [18]:
            xmin = 46.020000
            xmax = 54.460000
            text = "文物双全的人物吧，他最出名的事情就是龙场悟道，就是当时他被贬官，然后到。"
        intervals [19]:
            xmin = 54.460000
            xmax = 54.960000
            text = ""
        intervals [20]:
            xmin = 54.960000
            xmax = 57.410000
            text = "额，还有格格竹失败之后。"
        intervals [21]:
            xmin = 57.410000
            xmax = 58.030000
            text = ""
        intervals [22]:
            xmin = 58.030000
            xmax = 60.610000
            text = "在龙场那个地方，然后。"
        intervals [23]:
            xmin = 60.610000
            xmax = 61.540000
            text = ""
        intervals [24]:
            xmin = 61.540000
            xmax = 69.070000
            text = "额，明白了一个事理，发明了心学吗，之后他凭借着这个心境还有。"
        intervals [25]:
            xmin = 69.070000
            xmax = 69.540000
            text = ""
        intervals [26]:
            xmin = 69.540000
            xmax = 71.390000
            text = "额，见识。"
        intervals [27]:
            xmin = 71.390000
            xmax = 72.120000
            text = ""
        intervals [28]:
            xmin = 72.120000
            xmax = 76.430000
            text = "最后是，一步步往上走，然后完成了一番大事业。"
        intervals [29]:
            xmin = 76.430000
            xmax = 85.110000
            text = ""
        intervals [30]:
            xmin = 85.110000
            xmax = 88.930000
            text = "额，龙场悟道其实主要是他以前。"
        intervals [31]:
            xmin = 88.930000
            xmax = 89.270000
            text = ""
        intervals [32]:
            xmin = 89.270000
            xmax = 97.930000
            text = "最早学那个朱熹的理学，然后当时对他的见解是就是，里里，了解到这个格物这个词嘛。"
        intervals [33]:
            xmin = 97.930000
            xmax = 98.090000
            text = ""
        intervals [34]:
            xmin = 98.090000
            xmax = 102.330000
            text = "然后王阳明格竹，就在家里面一直看竹子想一个事情。"
        intervals [35]:
            xmin = 102.330000
            xmax = 102.710000
            text = ""
        intervals [36]:
            xmin = 102.710000
            xmax = 106.780000
            text = "然后他就钻了牛角尖，然后一直不明白，最后是。"
        intervals [37]:
            xmin = 106.780000
            xmax = 107.030000
            text = ""
        intervals [38]:
            xmin = 107.030000
            xmax = 110.930000
            text = "经历种种之后，他在龙场那里就是发现。"
        intervals [39]:
            xmin = 110.930000
            xmax = 111.310000
            text = ""
        intervals [40]:
            xmin = 111.310000
            xmax = 116.850000
            text = "额，这个事情并不是，格竹并不是格于外，而是格于内，也就是自己的内心。"
        intervals [41]:
            xmin = 116.850000
            xmax = 117.260000
            text = ""
        intervals [42]:
            xmin = 117.260000
            xmax = 119.140000
            text = "就是。"
        intervals [43]:
            xmin = 119.140000
            xmax = 119.330000
            text = ""
        intervals [44]:
            xmin = 119.330000
            xmax = 123.260000
            text = "更偏向于，唯心论的那种感觉，就是那个心学。"
        intervals [45]:
            xmin = 123.260000
            xmax = 344.650000
            text = ""
        intervals [46]:
            xmin = 344.650000
            xmax = 351.560000
            text = "蔡徐坤当初，额当初面对这个网暴的事情，最一开始他的态度是比较坚决的，就是。"
        intervals [47]:
            xmin = 351.560000
            xmax = 351.880000
            text = ""
        intervals [48]:
            xmin = 351.880000
            xmax = 353.770000
            text = "额，想要。"
        intervals [49]:
            xmin = 353.770000
            xmax = 356.300000
            text = ""
        intervals [50]:
            xmin = 356.300000
            xmax = 360.080000
            text = "对，想要自己维权，然后进行维护到底，但是后来。"
        intervals [51]:
            xmin = 360.080000
            xmax = 360.300000
            text = ""
        intervals [52]:
            xmin = 360.300000
            xmax = 365.430000
            text = "又转变了态度，就是接受了大家这种拿他开玩笑的那种状态，你怎么看。"
        intervals [53]:
            xmin = 365.430000
            xmax = 1122.150000
            text = ""
        intervals [54]:
            xmin = 1122.150000
            xmax = 1123.690000
            text = "嗯，梦泪的。"
        intervals [55]:
            xmin = 1123.690000
            xmax = 1124.050000
            text = ""
        intervals [56]:
            xmin = 1124.050000
            xmax = 1131.430000
            text = "额活度的话我感觉是更广泛的，像是一诺这种选手，可能在职业圈或者是，额。"
        intervals [57]:
            xmin = 1131.430000
            xmax = 1132.070000
            text = ""
        intervals [58]:
            xmin = 1132.070000
            xmax = 1136.270000
            text = "额技术，玩玩家那里名气会更高一点或者评价会更好一点。"
        intervals [59]:
            xmin = 1136.270000
            xmax = 1428.192667
            text = ""
