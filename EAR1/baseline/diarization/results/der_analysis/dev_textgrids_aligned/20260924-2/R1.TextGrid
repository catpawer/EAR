            text = ""
        intervals [14]:
            xmin = 173.490000
            xmax = 177.040000
            text = "额但是他家里还是对他比较支持的吧。"
        intervals [15]:
            xmin = 177.040000
            xmax = 177.560000
            text = ""
        intervals [16]:
            xmin = 177.560000
            xmax = 178.340000
            text = "噢。"
