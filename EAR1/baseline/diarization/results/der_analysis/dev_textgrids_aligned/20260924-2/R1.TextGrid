            xmin = 9.490000
            xmax = 396.040000
            text = ""
        intervals [4]:
            xmin = 396.040000
            xmax = 397.910000
            text = "我觉得你说的这个。"
        intervals [5]:
            xmin = 397.910000
            xmax = 398.370000
            text = ""
        intervals [6]:
            xmin = 398.370000
            xmax = 404.640000
            text = "当然这个事情是一个好的事情但是就，呃我据我所知道的吧。"
        intervals [7]:
            xmin = 404.640000
            xmax = 404.990000
            text = ""
        intervals [8]:
            xmin = 404.990000
            xmax = 413.550000
            text = "最开始蔡徐坤是我记得，我是我初中那年开始火初中初几我忘了开始火的，当时没有这么多人黑他这个梗也确实有人玩儿。"
        intervals [9]:
            xmin = 413.550000
            xmax = 414.030000
            text = ""
        intervals [10]:
            xmin = 414.030000
            xmax = 414.780000
            text = "额。"
        intervals [11]:
            xmin = 414.780000
            xmax = 415.000000
            text = ""
        intervals [12]:
            xmin = 415.000000
            xmax = 420.670000
            text = "过后这段时间其实那个梗火的时间不是很长一两三年之后他就不火了然后过了。"
        intervals [13]:
            xmin = 420.670000
            xmax = 421.140000
            text = ""
        intervals [14]:
            xmin = 421.140000
            xmax = 430.830000
            text = "过去一段时间就被又被人重新挖出来，然后这个梗又重新火的，我觉得其实你说的什么网暴啊，什么黑子我觉得这种这些人。"
        intervals [15]:
            xmin = 430.830000
            xmax = 430.960000
            text = ""
        intervals [16]:
            xmin = 430.960000
            xmax = 437.640000
            text = "都其实就是一群跟风的我觉得一群人都在说他。我觉得他长得帅，他是男的我就要我就要说他怎么怎么样的我觉得根本就不是说。"
        intervals [17]:
            xmin = 437.640000
            xmax = 437.840000
            text = ""
        intervals [18]:
            xmin = 437.840000
            xmax = 440.710000
            text = "甚至是没有了解，了解过这个明星。"
        intervals [19]:
            xmin = 440.710000
            xmax = 440.960000
            text = ""
        intervals [20]:
            xmin = 440.960000
            xmax = 443.230000
            text = "那我，说他们网，我觉得连。"
        intervals [21]:
            xmin = 443.230000
            xmax = 443.530000
            text = ""
        intervals [22]:
            xmin = 443.530000
            xmax = 445.530000
            text = "根本就算不上网暴，其实。"
        intervals [23]:
            xmin = 445.530000
            xmax = 445.970000
            text = ""
        intervals [24]:
            xmin = 445.970000
            xmax = 452.800000
            text = "就真的，不说什么律师函吧，就随便一个发个声闻或者都感觉能给能给能给那些人吓哭了。"
        intervals [25]:
            xmin = 452.800000
            xmax = 453.160000
            text = ""
        intervals [26]:
            xmin = 453.160000
            xmax = 463.990000
            text = "而且我们现在所说的什么什么小黑子，什么路转粉，还是那句话就是跟风，就是他可能连蔡徐坤的歌没听过，呃事情不知道呃，或者是。"
        intervals [27]:
            xmin = 463.990000
            xmax = 464.260000
            text = ""
        intervals [28]:
            xmin = 464.260000
            xmax = 471.330000
            text = "什么大概都没有了解就觉得就觉得这么多人都说路转粉了，这么多人都都说他那啥了，然后我也跟着转。"
        intervals [29]:
            xmin = 471.330000
            xmax = 471.510000
            text = ""
        intervals [30]:
            xmin = 471.510000
            xmax = 480.960000
            text = "觉得自己笑梗不笑人，觉得自己有有那个理解，有见解其实就是根根归根结底就两个字，从开始到结尾，从黑他到粉他，就是两个字跟风。"
        intervals [31]:
