        intervals [4]:
            xmin = 124.650000
            xmax = 131.290000
            text = "好，那我也说一下我喜欢的一个人，额我比较喜欢就是最近比较流行的那个，周杰伦。"
        intervals [5]:
            xmin = 131.290000
